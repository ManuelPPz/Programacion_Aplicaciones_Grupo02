          <Properties>
            <Property name="model" type="javax.swing.table.TableModel" editor="org.netbeans.modules.form.editors2.TableModelEditor" postCode="tablePrevias.getSelectionModel().addListSelectionListener(e -&gt; {&#xa;    if (!e.getValueIsAdjusting()) {&#xa;        int fila = tablePrevias.getSelectedRow();&#xa;        if (fila != -1) {&#xa;            //Logica de mostrar curso&#xa;            String nombre = (String)tablePrevias.getValueAt(fila, 0);&#xa;            DTMaster dt = ico.ConsultaCurso(nombre,institutoNom);&#xa;            MiniInterfazDeConsultaCurso micc = new MiniInterfazDeConsultaCurso();&#xa;            this.getDesktopPane().add(micc);&#xa;            micc.setTitle(&quot;(Info) &quot;+nombre);&#xa;            micc.setLocation(0, 0);&#xa;&#xa;            micc.setVisible(true);&#xa;            &#xa;            try {&#xa;                micc.setSelected(true);&#xa;            } catch (java.beans.PropertyVetoException ex) {&#xa;                ex.printStackTrace();&#xa;            }&#xa;&#xa;            micc.toFront();&#xa;            micc.ColocarDatos(dt);&#xa;        }&#xa;    }&#xa;});">
              <Table columnCount="1" rowCount="0">
                <Column editable="false" title="Cursos Previos" type="java.lang.String"/>
              </Table>
            </Property>
